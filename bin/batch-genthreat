#!/bin/bash

# Batch genthreat runner for multiple product IDs
# Usage: ./batch-genthreat

PRODUCT_IDS="1459, 416, 632, 1427, 528, 85, 667, 402, 1495, 350, 158, 213, 651, 790, 1476, 414, 1084, 42, 396, 1311, 405, 1500, 1215, 1497, 1336, 199, 1435, 1451, 1356, 518"
MODEL_ID=37

# Convert comma-separated list to array
IFS=',' read -ra IDS <<< "$PRODUCT_IDS"

echo "Running genthreat for ${#IDS[@]} product IDs with model_id=$MODEL_ID"
echo "=========================================="

for product_id in "${IDS[@]}"; do
  # Remove leading/trailing whitespace
  product_id=$(echo "$product_id" | xargs)
  
  echo "Processing product_id=$product_id..."
  ./genthreat generate --product-id="$product_id" --model-id=$MODEL_ID
  
  if [ $? -eq 0 ]; then
    echo "✓ Product $product_id completed successfully"
  else
    echo "✗ Product $product_id failed with status $?"
  fi
  echo "---"
done

echo "=========================================="
echo "Batch processing complete"
