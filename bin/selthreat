#!/usr/bin/env python3
"""selthreat - Select and bulk-import threats from canonical basis set.

This tool selects the most plausible threats from the canonical basis set
(model_id=37) for given FDA-cleared AI-enabled medical devices, then copies
them into a target threat model.

Usage (select is the default command):
    ./bin/selthreat --model-id=2 --product-id=5
    ./bin/selthreat --model-id=2 --product-ids=5,12,18 --count=10
    ./bin/selthreat --model-id=2 --product-id=5 --dry-run
    ./bin/selthreat list --product-id=5 --count=8
    ./bin/selthreat --model-id=2 --product-id=5 --model=gpt-4o-mini

Or with explicit 'select' command:
    ./bin/selthreat select --model-id=2 --product-id=5
    ./bin/selthreat select --model-id=2 --product-ids=5,12,18 --count=10

Commands:
  select                Select and import threats for product(s) into a target model
  list                  Preview selected threats without importing

Common Arguments:
  --product-id ID       Single product ID to process
  --product-ids IDS     Comma-separated list of product IDs
  --model-id ID         Target threat model ID (required for 'select')
  --count N             Number of threats to select (default 10, min 8, max 12)
  --model MODEL         LLM model for threat selection (default: gpt-4o-mini)
  --canonical-model-id  Canonical basis set model ID (default: 37)
  --dry-run             Preview selections without writing to database
  --verbose             Enable verbose logging

  --create-model        Create a new threat model named '{product-name}+SELTHREAT' and use it as target.
                        Useful for isolated test runs comparing with genthreat output.

Environment Variables (required in .env):
  DATABASE_URL          PostgreSQL connection string
  OPENAI_API_KEY        OpenAI API key for LLM threat selection
"""

import argparse
import asyncio
import json
import logging
import os
import sys
from typing import List

backend_path = os.path.join(os.path.dirname(__file__), "..", "backend")
sys.path.insert(0, backend_path)

from services.threat_selector_service import ThreatSelectorService, DEFAULT_THREAT_COUNT, MIN_THREAT_COUNT, MAX_THREAT_COUNT, DEFAULT_CANONICAL_MODEL_ID

logger = logging.getLogger("selthreat")


async def select_command(args: argparse.Namespace) -> int:
    """Execute the select subcommand."""
    product_ids = parse_product_ids(args)
    if not product_ids:
        logger.error("At least one product ID is required (--product-id or --product-ids)")
        return 1

    # Handle --create-model flag
    target_model_id = args.model_id
    if getattr(args, "create_model", False):
        if len(product_ids) > 1:
            logger.error("--create-model is only supported with a single --product-id")
            return 1
        # We'll create the model after initializing the service
    elif target_model_id is None:
        logger.error("--model-id is required for the select command (unless using --create-model)")
        return 1

    threat_count = clamp_threat_count(args.count)
    db_url = os.getenv("DATABASE_URL")
    if not db_url:
        logger.error("DATABASE_URL environment variable not set")
        return 1

    service = ThreatSelectorService(
        db_url=db_url,
        dry_run=args.dry_run,
        llm_model=args.model,
        canonical_model_id=args.canonical_model_id,
    )

    try:
        await service.initialize()
        
        # Create model if --create-model is specified
        if getattr(args, "create_model", False):
            product_id = product_ids[0]
            device_profile = await service.get_device_profile(product_id)
            product_name = device_profile["device"]
            target_model_id = await service.create_model(product_name, suffix="SELTHREAT")
        
        logger.info("Processing %d product(s) with threat count %d into model_id=%d", len(product_ids), threat_count, target_model_id)

        all_results = []
        for i, product_id in enumerate(product_ids, 1):
            logger.info("[%d/%d] Selecting threats for product_id=%d", i, len(product_ids), product_id)
            try:
                result = await service.select_threats_for_device(
                    target_model_id=target_model_id,
                    device_id=product_id,
                    threat_count=threat_count,
                )
                all_results.append(result)
                print_result(result)
                print()  # blank line
            except Exception as e:
                logger.error("Failed to select threats for product_id=%d: %s", product_id, str(e))
                if not args.dry_run:
                    logger.error("Transaction rolled back; no threats inserted")
                    return 1

        # Summary
        if all_results:
            total_selected = sum(r["threat_count_selected"] for r in all_results)
            total_inserted = sum(r["threat_count_inserted"] for r in all_results)
            logger.info(
                "Summary: %d product(s) processed, %d threats selected, %d threats inserted",
                len(all_results),
                total_selected,
                total_inserted,
            )
            if args.dry_run:
                logger.info("(dry-run mode: no threats actually inserted)")

        return 0

    except Exception as e:
        logger.error("Fatal error: %s", str(e))
        return 1
    finally:
        await service.cleanup()


async def list_command(args: argparse.Namespace) -> int:
    """Execute the list subcommand."""
    if args.product_id is None:
        logger.error("--product-id is required for the list command")
        return 1

    threat_count = clamp_threat_count(args.count)
    db_url = os.getenv("DATABASE_URL")
    if not db_url:
        logger.error("DATABASE_URL environment variable not set")
        return 1

    service = ThreatSelectorService(
        db_url=db_url,
        dry_run=True,  # list is always a preview
        llm_model=args.model,
        canonical_model_id=args.canonical_model_id,
    )

    try:
        await service.initialize()
        logger.info("Previewing threats for product_id=%d (threat_count=%d)", args.product_id, threat_count)

        result = await service.list_selected_threats(
            device_id=args.product_id,
            threat_count=threat_count,
        )
        print_result(result)
        return 0

    except Exception as e:
        logger.error("Fatal error: %s", str(e))
        return 1
    finally:
        await service.cleanup()


def parse_product_ids(args: argparse.Namespace) -> List[int]:
    """Parse product IDs from args."""
    product_ids = []
    if args.product_id is not None:
        product_ids.append(args.product_id)
    if hasattr(args, "product_ids") and args.product_ids:
        try:
            product_ids.extend([int(p.strip()) for p in args.product_ids.split(",")])
        except ValueError as e:
            logger.error("Invalid product ID format: %s", str(e))
            return []
    return product_ids


def clamp_threat_count(count: int) -> int:
    """Clamp threat count to valid range."""
    if count < MIN_THREAT_COUNT:
        logger.warning("Threat count %d is below minimum %d, using minimum", count, MIN_THREAT_COUNT)
        return MIN_THREAT_COUNT
    if count > MAX_THREAT_COUNT:
        logger.warning("Threat count %d exceeds maximum %d, using maximum", count, MAX_THREAT_COUNT)
        return MAX_THREAT_COUNT
    return count


def print_result(result: dict) -> None:
    """Pretty-print a result dictionary."""
    print(json.dumps(result, indent=2, default=str))


def setup_logging(verbose: bool) -> None:
    """Configure logging level."""
    level = logging.DEBUG if verbose else logging.INFO
    logging.basicConfig(
        level=level,
        format="%(asctime)s [%(levelname)s] %(name)s - %(message)s",
    )


async def main() -> int:
    """Main entry point."""
    # Auto-prepend 'select' command if first arg is not a known command
    argv = sys.argv[1:]
    if argv and argv[0] not in {"select", "list", "-h", "--help"}:
        argv = ["select", *argv]
    elif not argv:
        argv = ["select"]
    
    parser = argparse.ArgumentParser(
        description="Select and bulk-import threats from canonical basis set",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    subparsers = parser.add_subparsers(dest="command", required=True, help="Command to execute")

    # select subcommand
    select_parser = subparsers.add_parser("select", help="Select and import threats")
    select_parser.add_argument(
        "--model-id",
        type=int,
        default=None,
        help="Target threat model ID (required unless using --create-model)",
    )
    product_group = select_parser.add_mutually_exclusive_group(required=True)
    product_group.add_argument(
        "--product-id",
        type=int,
        help="Single product ID",
    )
    product_group.add_argument(
        "--product-ids",
        type=str,
        help="Comma-separated product IDs",
    )
    select_parser.add_argument(
        "--count",
        type=int,
        default=DEFAULT_THREAT_COUNT,
        help=f"Number of threats to select (default {DEFAULT_THREAT_COUNT}, min {MIN_THREAT_COUNT}, max {MAX_THREAT_COUNT})",
    )
    select_parser.add_argument(
        "--model",
        default="gpt-5.6-terra",
        help="LLM model for threat selection (default: gpt-5.6-terra)",
    )
    select_parser.add_argument(
        "--canonical-model-id",
        type=int,
        default=DEFAULT_CANONICAL_MODEL_ID,
        help=f"Canonical basis set model ID (default: {DEFAULT_CANONICAL_MODEL_ID})",
    )
    select_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Preview selections without writing to database",
    )
    select_parser.add_argument(
        "--verbose",
        action="store_true",
        help="Enable verbose logging",
    )
    select_parser.add_argument(
        "--create-model",
        action="store_true",
        help="Create a new threat model named '{product-name}+SELTHREAT' and use it as target.",
    )
    select_parser.set_defaults(func=select_command)

    # list subcommand
    list_parser = subparsers.add_parser("list", help="Preview selected threats")
    list_parser.add_argument(
        "--product-id",
        type=int,
        required=True,
        help="Product ID to preview",
    )
    list_parser.add_argument(
        "--count",
        type=int,
        default=DEFAULT_THREAT_COUNT,
        help=f"Number of threats to preview (default {DEFAULT_THREAT_COUNT}, min {MIN_THREAT_COUNT}, max {MAX_THREAT_COUNT})",
    )
    list_parser.add_argument(
        "--model",
        default="gpt-5.6-terra",
        help="LLM model for threat selection (default: gpt-5.6-terra)",
    )
    list_parser.add_argument(
        "--canonical-model-id",
        type=int,
        default=DEFAULT_CANONICAL_MODEL_ID,
        help=f"Canonical basis set model ID (default: {DEFAULT_CANONICAL_MODEL_ID})",
    )
    list_parser.add_argument(
        "--verbose",
        action="store_true",
        help="Enable verbose logging",
    )
    list_parser.set_defaults(func=list_command)

    args = parser.parse_args(argv)
    setup_logging(args.verbose)

    return await args.func(args)


if __name__ == "__main__":
    exit_code = asyncio.run(main())
    sys.exit(exit_code)
