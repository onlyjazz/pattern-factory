#!/bin/bash

set -euo pipefail

# FEELGOOD Batch Execution Script
# 
# Extracts competitive advantage claims for FDA-approved medical devices.
#
# Usage:
#     ./feelgood --products 1-50              # Run for products 1 through 50
#     ./feelgood --products 1,5,10,20         # Run for specific product IDs
#     ./feelgood --product 42                 # Run for single product
#     ./feelgood --products 1-50 --dry-run    # Validate without executing
#
# Environment:
#     DATABASE_URL: PostgreSQL connection string
#     EXA_API_KEY: Exa search API key
#     OPENAI_API_KEY: OpenAI GPT-4o API key

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get script directory
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BACKEND_DIR="$PROJECT_ROOT/backend"

# Load environment variables from .env
if [ -f "$PROJECT_ROOT/.env" ]; then
    set -a
    source "$PROJECT_ROOT/.env"
    set +a
fi

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $*"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $*"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
}

# Validate environment variables
validate_env() {
    local missing=0
    
    if [ -z "${DATABASE_URL:-}" ]; then
        log_error "DATABASE_URL environment variable not set"
        missing=1
    fi
    
    if [ -z "${OPENAI_API_KEY:-}" ]; then
        log_error "OPENAI_API_KEY environment variable not set"
        missing=1
    fi
    
    if [ -z "${EXA_API_KEY:-}" ]; then
        log_warn "EXA_API_KEY environment variable not set (required for web search)"
    fi
    
    if [ $missing -eq 1 ]; then
        return 1
    fi
    return 0
}

# Parse product IDs from command line arguments
# Supports: --products 1-50, --products 1,5,10, --product 42
parse_product_ids() {
    local product_ids=()
    local i=0
    
    while [ $i -lt ${#@} ]; do
        local arg="${@:$((i+1)):1}"
        
        case "$arg" in
            --products)
                i=$((i+1))
                if [ $i -lt ${#@} ]; then
                    local spec="${@:$((i+1)):1}"
                    
                    if [[ "$spec" == *"-"* ]]; then
                        # Handle range (1-50)
                        local start end
                        start=$(echo "$spec" | cut -d'-' -f1)
                        end=$(echo "$spec" | cut -d'-' -f2)
                        for id in $(seq "$start" "$end"); do
                            product_ids+=("$id")
                        done
                    elif [[ "$spec" == *","* ]]; then
                        # Handle comma-separated list (1,5,10)
                        IFS=',' read -ra ids <<< "$spec"
                        for id in "${ids[@]}"; do
                            product_ids+=("$(echo "$id" | xargs)")
                        done
                    else
                        # Single product
                        product_ids+=("$spec")
                    fi
                    i=$((i+1))
                fi
                ;;
            --product)
                i=$((i+1))
                if [ $i -lt ${#@} ]; then
                    product_ids+=("${@:$((i+1)):1}")
                    i=$((i+1))
                fi
                ;;
            --dry-run)
                # Handled separately
                ;;
            *)
                ;;
        esac
        
        i=$((i+1))
    done
    
    # Sort and deduplicate
    if [ ${#product_ids[@]} -gt 0 ]; then
        printf '%s\n' "${product_ids[@]}" | sort -n -u | tr '\n' ' ' | sed 's/ $//'
    fi
}

# Create Python script and execute
run_feelgood_batch() {
    local product_ids="$1"
    local dry_run="$2"
    
    export PROJECT_ROOT
    export PYTHONPATH="$BACKEND_DIR:${PYTHONPATH:-}"
    
    # Build argument list for Python
    local py_args=()
    for id in $product_ids; do
        py_args+=("$id")
    done
    if [ "$dry_run" = "true" ]; then
        py_args+=("--dry-run")
    fi
    
    # Execute Python script with product IDs as arguments
    python3 - "${py_args[@]}" << 'PYTHON_SCRIPT'
import asyncio
import asyncpg
import json
import logging
import os
import sys
import uuid
from datetime import datetime
from dotenv import load_dotenv

# Load environment variables
env_path = os.path.join(os.environ.get('PROJECT_ROOT', '.'), ".env")
load_dotenv(dotenv_path=env_path)

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [%(levelname)s] %(message)s'
)
logger = logging.getLogger(__name__)

project_root = os.environ.get('PROJECT_ROOT')
backend_dir = os.path.join(project_root, 'backend')
if backend_dir not in sys.path:
    sys.path.insert(0, backend_dir)

from pitboss.supervisor import PitbossSupervisor

async def run_feelgood_for_products(product_ids, dry_run=False):
    db_url = os.getenv("DATABASE_URL")
    if not db_url:
        logger.error("❌ DATABASE_URL environment variable not set")
        return
    
    exa_key = os.getenv("EXA_API_KEY")
    if not exa_key:
        logger.warning("⚠️  EXA_API_KEY environment variable not set (required for web search)")
    
    openai_key = os.getenv("OPENAI_API_KEY")
    if not openai_key:
        logger.error("❌ OPENAI_API_KEY environment variable not set")
        return
    
    if dry_run:
        logger.info(f"🔍 [DRY RUN] Would process {len(product_ids)} products")
        return
    
    logger.info(f"📦 Connecting to database...")
    try:
        pool = await asyncpg.create_pool(db_url, min_size=1, max_size=5, command_timeout=300)
    except Exception as e:
        logger.error(f"❌ Database connection failed: {e}")
        return
    
    logger.info(f"🧠 Initializing Pitboss Supervisor...")
    supervisor = PitbossSupervisor(pool, websocket=None)
    
    results = {
        "success": 0,
        "failed": 0,
        "skipped": 0,
        "details": []
    }
    
    for i, product_id in enumerate(product_ids, 1):
        logger.info(f"\n[{i}/{len(product_ids)}] Processing product ID: {product_id}")
        
        try:
            session_id = f"feelgood-{datetime.utcnow().isoformat()}"
            request_id = f"req-{uuid.uuid4().hex[:8]}"
            
            message_body = {
                "product_id": product_id,
                "raw_text": f"feelgood {product_id}",
            }
            
            envelope_dict = {
                "type": "request",
                "version": "1.1",
                "session_id": session_id,
                "request_id": request_id,
                "verb": "FEELGOOD",
                "nextAgent": None,
                "messageBody": message_body
            }
            
            await supervisor.process_envelope(envelope_dict)
            
            results["success"] += 1
            results["details"].append({
                "product_id": product_id,
                "status": "success",
                "timestamp": datetime.utcnow().isoformat()
            })
            
            logger.info(f"✅ Product {product_id} processed successfully")
            
        except Exception as e:
            logger.error(f"❌ Product {product_id} failed: {e}", exc_info=False)
            results["failed"] += 1
            results["details"].append({
                "product_id": product_id,
                "status": "failed",
                "error": str(e),
                "timestamp": datetime.utcnow().isoformat()
            })
        
        if i < len(product_ids):
            await asyncio.sleep(2)
    
    logger.info(f"\n\n🎯 FEELGOOD Batch Complete")
    logger.info(f"  ✅ Success: {results['success']}")
    logger.info(f"  ❌ Failed:  {results['failed']}")
    logger.info(f"  ⏭️  Skipped: {results['skipped']}")
    logger.info(f"  📊 Total:   {len(product_ids)}")
    
    try:
        async with pool.acquire() as conn:
            await conn.execute(
                """
                INSERT INTO public.system_log (event, context)
                VALUES ($1, $2)
                """,
                "FEELGOOD_BATCH",
                json.dumps(results)
            )
    except Exception as e:
        logger.warning(f"Failed to log batch results: {e}")
    
    await pool.close()

if __name__ == "__main__":
    # Parse product IDs from command-line arguments
    product_ids = [int(x) for x in sys.argv[1:] if x.isdigit()]
    dry_run = '--dry-run' in sys.argv
    
    if not product_ids:
        logger.error("❌ No products specified")
        sys.exit(1)
    
    logger.info(f"🚀 Starting FEELGOOD batch...")
    logger.info(f"   Products: {product_ids}")
    logger.info(f"   Count: {len(product_ids)}")
    
    if dry_run:
        logger.info(f"   Mode: DRY RUN (validation only)")
    
    try:
        asyncio.run(run_feelgood_for_products(product_ids, dry_run=dry_run))
    except KeyboardInterrupt:
        logger.info("\n⏹️  Interrupted by user")
        sys.exit(0)
    except Exception as e:
        logger.error(f"❌ Fatal error: {e}", exc_info=True)
        sys.exit(1)
PYTHON_SCRIPT
}

# Main entry point
main() {
    # Parse arguments
    local dry_run="false"
    local args=("$@")
    
    for arg in "${args[@]}"; do
        if [ "$arg" = "--dry-run" ]; then
            dry_run="true"
        fi
    done
    
    # Parse product IDs
    local product_ids
    product_ids=$(parse_product_ids "$@")
    
    if [ -z "$product_ids" ]; then
        log_error "No products specified"
        echo "Usage: $0 --products 1-50"
        echo "       $0 --products 1,5,10,20"
        echo "       $0 --product 42"
        exit 1
    fi
    
    # Validate environment
    if ! validate_env; then
        exit 1
    fi
    
    log_info "🚀 Starting FEELGOOD batch..."
    log_info "   Products: $product_ids"
    log_info "   Count: $(echo "$product_ids" | wc -w)"
    
    if [ "$dry_run" = "true" ]; then
        log_info "   Mode: DRY RUN (validation only)"
    fi
    
    # Run FEELGOOD batch
    run_feelgood_batch "$product_ids" "$dry_run"
}

# Run main function if script is executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
