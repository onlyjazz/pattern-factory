#!/usr/bin/env python3
"""
CLI tool for batch processing product superiority using the FEELGOOD workflow.

Usage:
    ./bin/feelgood                      # Process up to 100 products
    ./bin/feelgood --range=1-50         # Process specific range
    ./bin/feelgood --product-ids=1,5    # Process specific IDs
    ./bin/feelgood --limit=200          # Custom limit

Environment Variables (required in .env):
    DATABASE_URL       PostgreSQL connection string
    EXA_API_KEY        Exa API key for web search
    OPENAI_API_KEY     OpenAI API key for LLM extraction

The FEELGOOD workflow:
  1. Validates product exists with device name and company
  2. Searches web for competitive advantage information via Exa
  3. Extracts superiority claims using LLM analysis
  4. Updates products.superiority field with competitive advantage data

Results are logged to system_log table as FEELGOOD_BATCH_COMPLETE event.
"""

import sys
import os
import asyncio

# Add backend to path so we can import services
backend_path = os.path.join(os.path.dirname(__file__), "..", "backend")
sys.path.insert(0, backend_path)

from services.feelgood_service import FEELGOODService


def print_help():
    """Print help message."""
    print(__doc__)


def main():
    """CLI entry point."""
    # Show help if requested
    if "--help" in sys.argv or "-h" in sys.argv:
        print_help()
        sys.exit(0)
    
    # Delegate to FEELGOODService.main() which handles all args
    from services.feelgood_service import main as service_main
    asyncio.run(service_main())


if __name__ == "__main__":
    main()
