#!/bin/bash

set -e

BACKUP_DIR="/Users/dl/Library/Mobile Documents/com~apple~CloudDocs/PostgreSQL Backups"
DB_NAME="pattern-factory"

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# All tables in pattern-factory database
declare -a ALL_TABLES=(
  "public.active_models"
  "public.cards"
  "public.categories"
  "public.orgs"
  "public.paths"
  "public.pattern_org_link"
  "public.pattern_people_link"
  "public.pattern_post_link"
  "public.patterns"
  "public.people"
  "public.posts"
  "public.products"
  "public.rbac"
  "public.roles"
  "public.system_log"
  "public.user_role"
  "public.users"
  "public.views_registry"
  "threat.area_asset"
  "threat.area_countermeasure"
  "threat.area_threat"
  "threat.area_vulnerability"
  "threat.areas"
  "threat.asset_threat"
  "threat.assets"
  "threat.attacker_threat"
  "threat.attacker_types"
  "threat.basis_runs"
  "threat.countermeasure_class"
  "threat.countermeasure_threat"
  "threat.countermeasures"
  "threat.entrypoint_threat"
  "threat.entrypoints"
  "threat.models"
  "threat.parameters"
  "threat.risk_history"
  "threat.threat_countermeasure_classes"
  "threat.threat_provenance"
  "threat.threats"
  "threat.vulnerabilities"
  "threat.vulnerability_threat"
)

# Function to display help
show_help() {
  cat << EOF
${BLUE}db-restore${NC} - Restore a table from pattern-factory database backup

${GREEN}USAGE:${NC}
  db-restore [OPTIONS]

${GREEN}OPTIONS:${NC}
  -t, --table TABLE       Specify table name (e.g., 'public.threats', 'threat.countermeasures')
  -b, --backup FILE       Specify backup file path (defaults to most recent backup)
  -l, --list              List all available tables and exit
  -h, --help              Show this help message

${GREEN}EXAMPLES:${NC}
  db-restore -t public.patterns                  # Restore patterns table
  db-restore --table threat.threats -b ~/backup.dump
  db-restore -l                                   # List all tables

${YELLOW}WARNING:${NC} This will DELETE all data in the selected table before restoring!

EOF
}

# Function to list tables
list_tables() {
  echo -e "${BLUE}Available tables in pattern-factory:${NC}\n"
  echo "${BLUE}Public schema:${NC}"
  for table in "${ALL_TABLES[@]}"; do
    if [[ $table == public.* ]]; then
      echo "  - $table"
    fi
  done
  echo -e "\n${BLUE}Threat schema:${NC}"
  for table in "${ALL_TABLES[@]}"; do
    if [[ $table == threat.* ]]; then
      echo "  - $table"
    fi
  done
}

# Function to find most recent backup
find_latest_backup() {
  local backup_file=$(ls -t "$BACKUP_DIR"/*.dump 2>/dev/null | head -1)
  if [ -z "$backup_file" ]; then
    echo -e "${RED}Error: No backup files found in $BACKUP_DIR${NC}"
    return 1
  fi
  echo "$backup_file"
}

# Function to extract table data from backup
restore_table() {
  local table=$1
  local backup_file=$2

  if [ ! -f "$backup_file" ]; then
    echo -e "${RED}Error: Backup file not found: $backup_file${NC}"
    return 1
  fi

  echo -e "${YELLOW}Restoring table: $table${NC}"
  echo -e "${YELLOW}From backup: $(basename "$backup_file")${NC}"
  echo ""

  # Prompt for confirmation
  read -p "$(echo -e ${RED}This will DELETE all data in $table. Continue? [y/N]:${NC} )" -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${YELLOW}Restore cancelled.${NC}"
    return 1
  fi

  # Extract schema and table name
  IFS='.' read -r schema tablename <<< "$table"

  # Create temporary SQL file
  local temp_sql=$(mktemp)
  trap "rm -f $temp_sql" EXIT

  # Extract table data from backup and restore
  echo -e "${BLUE}Extracting table data from backup...${NC}"
  
  # Use pg_restore to extract the table
  if pg_restore --data-only --table="$table" "$backup_file" > "$temp_sql" 2>/dev/null; then
    echo -e "${BLUE}Restoring to database...${NC}"
    
    # Begin transaction
    psql -d "$DB_NAME" << EOSQL
BEGIN TRANSACTION;

-- Disable triggers temporarily
ALTER TABLE "$schema"."$tablename" DISABLE TRIGGER ALL;

-- Truncate the table
TRUNCATE TABLE "$schema"."$tablename" CASCADE;

-- Re-enable triggers
ALTER TABLE "$schema"."$tablename" ENABLE TRIGGER ALL;

COMMIT;
EOSQL

    # Insert the restored data
    psql -d "$DB_NAME" < "$temp_sql"
    
    echo -e "${GREEN}✓ Table $table restored successfully!${NC}"
    return 0
  else
    echo -e "${RED}Error: Failed to extract table from backup${NC}"
    return 1
  fi
}

# Main script
TABLE=""
BACKUP_FILE=""

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    -t|--table)
      TABLE="$2"
      shift 2
      ;;
    -b|--backup)
      BACKUP_FILE="$2"
      shift 2
      ;;
    -l|--list)
      list_tables
      exit 0
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      echo -e "${RED}Unknown option: $1${NC}"
      show_help
      exit 1
      ;;
  esac
done

# If no table specified, show interactive menu
if [ -z "$TABLE" ]; then
  echo -e "${BLUE}db-restore - Interactive mode${NC}\n"
  
  # Show table options
  echo "Select a table to restore:"
  PS3="Enter selection (1-${#ALL_TABLES[@]}): "
  select table in "${ALL_TABLES[@]}"; do
    if [ -n "$table" ]; then
      TABLE=$table
      break
    else
      echo "Invalid selection"
    fi
  done
fi

# Validate table name
valid_table=false
for tbl in "${ALL_TABLES[@]}"; do
  if [ "$tbl" = "$TABLE" ]; then
    valid_table=true
    break
  fi
done

if [ "$valid_table" = false ]; then
  echo -e "${RED}Error: Unknown table: $TABLE${NC}"
  echo "Use 'db-restore --list' to see available tables"
  exit 1
fi

# Find backup file if not specified
if [ -z "$BACKUP_FILE" ]; then
  echo -e "${BLUE}Looking for latest backup...${NC}"
  BACKUP_FILE=$(find_latest_backup) || exit 1
  echo "Using: $(basename "$BACKUP_FILE")"
fi

# Perform the restore
restore_table "$TABLE" "$BACKUP_FILE"
