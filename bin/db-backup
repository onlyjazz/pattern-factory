#!/bin/bash

BACKUP_DIR="/Users/dl/Library/Mobile Documents/com~apple~CloudDocs/PostgreSQL Backups"
mkdir -p "$BACKUP_DIR"

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_FILE="$BACKUP_DIR/pattern-factory-backup-$TIMESTAMP.dump"

echo "Starting backup at $(date)"
pg_dump -d pattern-factory --no-password -Fc -f "$BACKUP_FILE"

if [ $? -ne 0 ]; then
  echo "Error: pg_dump failed"
  exit 1
fi

echo "Compressing backup..."
gzip "$BACKUP_FILE"

if [ $? -ne 0 ]; then
  echo "Error: gzip failed"
  exit 1
fi

echo "Backup completed: ${BACKUP_FILE}.gz"

# Cleanup old backups (keep only last 7 days)
echo "Cleaning up backups older than 7 days..."
find "$BACKUP_DIR" -name "pattern-factory-backup-*.dump.gz" -type f -mtime +7 -delete

echo "Backup complete!"
